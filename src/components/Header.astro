---
import { Image } from 'astro:assets';
import profileImg from '@/assets/profile.png';

const response = await fetch(
	"https://wytvhv1azj.execute-api.eu-central-1.amazonaws.com/request-event",
	{
		method: "POST"
	}
);
const data = await response.json();
const count = data.count;
---

<header class="flex items-center gap-4">
  <Image
    src={profileImg}
    alt="A description of my image."
    class="w-23 h-23 object-cover rounded-full"
  />
  <hgroup class="flex-1 flex flex-col items-start">
    <h1 class="title text-grey-1">Bastien Winant</h1>
    <p class="body text-grey-2">DevOps Engineer</p>
    <p class="mt-1 px-2.5 pt-0.5 pb-0.75 rounded-xl text-xs bg-grey-4 text-grey-3">visitor count: {count}</p>
  </hgroup>
</header>