---
import Layout from '@/layouts/Layout.astro';
import Section from '@/components/Section.astro';
import RowGroup from '@/components/RowGroup.astro';
import RowItem from '@/components/RowItem.astro';
import Link from '@/components/Link.astro';
---

<Layout>
	<div class="flex flex-col gap-14.5">
		<Section title="about">
			<p class="body text-grey-2">
				I’m a passionate UX designer striving to create intuitive and engaging experiences.
				I’m a big believer that things can always be simpler than we think.
			</p>
		</Section>
		<Section title="certifications">
			<RowGroup>
				<RowItem>
					<Link
						label="AWS Certified AI Practitioner"
						href="https://www.credly.com/badges/f4c74fa1-03c7-4b0d-aec7-a8af0c273439"
					/>
				</RowItem>
				<RowItem>
					<Link
						label="AWS Certified Data Engineer – Associate"
						href="https://www.credly.com/badges/b12c39df-bd59-4a65-a256-968c082404ee"
					/>
				</RowItem>
				<RowItem>
					<Link
						label="AWS Certified Solutions Architect – Associate"
						href="https://www.credly.com/badges/25296c31-3e3e-4f3b-abdc-7c178d466ed1"
					/>
				</RowItem>
			</RowGroup>
		</Section>
		<Section title="contact" as="footer">
			<RowGroup>
				<RowItem>
					<Link label="bastien.winant@gmail.com" href="mailto:bastien.winant@gmail.com" />
				</RowItem>
				<RowItem>
					<Link label="bastienwinant" href="https://www.linkedin.com/in/bastienwinant" />
				</RowItem>
				<RowItem>
					<Link label="bastien-winant" href="https://www.github.com/bastien-winant" />
				</RowItem>
			</RowGroup>
		</Section>
	</div>
</Layout>
